# Salin ke .env lalu isi:  cp .env.example .env && chmod 600 .env
# JANGAN commit .env. Putar (rotate) kunci jika pernah bocor.

# --- Wajib ---
# Buat dengan: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource-anda>.openai.azure.com/
AZURE_OPENAI_API_KEY=
MCP_SERVER_URL=https://<apim-anda>.azure-api.net/POS/mcp
MCP_SUBSCRIPTION_KEY=

# --- Opsional ---
MODEL_DEPLOYMENT=gpt-5-mini
MCP_TOOL_NAME=whenAnHttpRequestIsReceivedInvoke
REASONING_EFFORT=low

# production (default) | dev. Di dev, SECRET_KEY boleh kosong.
APP_ENV=production
# 1 (default) = cookie hanya lewat HTTPS. Isi 0 HANYA untuk tes lokal via http://
COOKIE_SECURE=1
# Jumlah proxy tepercaya di depan aplikasi (nginx/caddy = 1). Isi 0 bila app diakses langsung tanpa proxy.
TRUSTED_PROXIES=1
# Origin tambahan yang boleh memanggil API (pisahkan koma). Biasanya kosong.
ALLOWED_ORIGINS=
# Token untuk /healthz?deep=1 (kirim di header X-Health-Token). Kosong = deep check nonaktif.
HEALTH_TOKEN=

# --- Batas ---
RATE_LIMIT_PER_MIN=15
DAILY_MESSAGE_LIMIT=2000
MAX_MESSAGE_CHARS=1500
MAX_TURNS_PER_CONVERSATION=40
VERIFY_ATTEMPTS_PER_SESSION=10
VERIFY_ATTEMPTS_PER_IP=30
MAX_QTY=50

# --- Server (dipakai startup.sh) ---
PORT=8000
# Biarkan 1: state sesi dan rate limit ada di memori proses. Skala lewat THREADS.
WEB_CONCURRENCY=1
THREADS=16
